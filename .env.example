# Nunca registre valores reais neste arquivo.
APP_ENV=development
# O site real é o padrão. Use true somente quando quiser abrir a demonstração sintética.
DEMO_MODE=false
# Domínio opcional: configurar no servidor após conferir os domínios e certificados no Render.
# PUBLIC_APP_ORIGIN=https://alvitra.app
# PUBLIC_APP_ALIASES=www.alvitra.app,alvitraapp.com,www.alvitraapp.com
# Mantém os documentos sintéticos fora da demonstração manual. Ative apenas para testes de consulta.
DEMO_SEED_DOCUMENTS=false
# Em testes locais, use false para não restaurar automaticamente a sessão no navegador.
AUTH_SESSION_AUTO_RESTORE=false
# Proteção de conta. A chave deve representar 32 bytes (hexadecimal ou base64url).
# Gere uma chave exclusiva por ambiente e nunca a versione.
# AUTH_ACCOUNT_SECRET_KEY=
# Sem provedor aprovado, apenas a prévia local pode ser usada fora de produção.
# A prévia não libera novas ativações de MFA.
# AUTH_EMAIL_DELIVERY=development
# AUTH_PUBLIC_BASE_URL=http://127.0.0.1:5173/
# No ambiente integrado de teste, processa uploads sem exigir outro terminal.
DOCUMENT_WORKER_IN_API=true
# Perfil separado: false na API e worker:continuous em outro processo.
# O worker rejeita DEMO_MODE=true; o comando worker anterior executa somente uma tarefa.
# DOCUMENT_WORKER_DATABASE_URL=postgresql://<worker-role>:<password>@<database-host>:5432/postgres?sslmode=verify-full
# Se o banco exigir CA própria, informar o PEM completo somente no segredo do worker.
# DOCUMENT_WORKER_SSL_CA=
DOCUMENT_WORKER_POLL_MS=1000
DOCUMENT_WORKER_LEASE_SECONDS=300
DOCUMENT_WORKER_HEARTBEAT_MS=30000
LOG_LEVEL=info
# Worker persistido: usa PostgreSQL com RLS e fila no banco.
# DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/conselheiro
# Supabase persistente: use o projeto do ambiente com TLS; nunca versionar a senha.
# DATABASE_URL=postgresql://<role>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Perfil autorizado da Spec 078: CA PEM opcional; TLS remoto continua verificando certificado.
# DATABASE_SSL_CA=
# JSON aprovado conforme infrastructure/pilot/persistent-execution-policy.example.json.
# Ausente por padrão; exige revisão idêntica enabled no banco e um único provedor aprovado.
# Para OpenAI, OPENAI_ANSWER_ROUTING=single; Gemini preserva o modelo aprovado existente.
# ALVITRA_PERSISTENT_EXECUTION_POLICY=
# DOCUMENT_STORAGE_ROOT=.local/synthetic-documents
# OCR da OpenAI: somente harness sintético direto, nunca upload do servidor/worker.
# A chave do chat NÃO ativa OCR. Os três campos abaixo são obrigatórios no harness.
# OPENAI_OCR_ENABLED=true
# OPENAI_OCR_DATA_POLICY=synthetic-only
# OPENAI_OCR_API_KEY=
# OPENAI_OCR_MODEL=gpt-5.6-luna
# OPENAI_OCR_TIMEOUT_MS=30000
# Conversas pelo plano ChatGPT/Codex: somente demonstração pessoal local sintética.
# Execute codex login com ChatGPT; não copie tokens para este arquivo.
# Exige DEMO_MODE=true e APP_ENV=development; não há fallback para API neste modo.
CODEX_ANSWER_ENABLED=false
CODEX_ANSWER_MODEL=gpt-6.1-sol
# Padrão: híbrido, Luna high para simples e Sol 6.1 low para complexas.
# single preserva CODEX_ANSWER_MODEL e esforço low.
CODEX_ANSWER_ROUTING=hybrid
CODEX_ANSWER_TIMEOUT_MS=120000
# Analisa documentos de teste sem recusa apenas pela origem sintética nem aviso rotineiro na fala.
# Exclusivo de APP_ENV=development, DEMO_MODE=true e CODEX_ANSWER_ENABLED=true, fora de produção.
# Preserva evidências, citações, autorização e isolamento; não comprova autenticidade real.
ALVITRA_LOCAL_TEST_DOCUMENTS_ENABLED=false
# CODEX_CLI_PATH=C:\caminho\para\codex.exe
# Respostas com OpenAI: configure no servidor, nunca com prefixo VITE_.
# OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-6.1-sol
OPENAI_ANSWER_ROUTING=hybrid
OPENAI_ANSWER_TIMEOUT_MS=45000
# OPENAI_ANSWER_ENABLED=true
# Gemini permanece disponível durante a migração e assume a conversa quando OpenAI não tem chave.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_RETRY_BASE_DELAY_MS=200
# GEMINI_ENABLED=true
# Fotos sintéticas: exige chave OpenAI, opt-in e confirmação operacional de billing.
# OPENAI_IMAGE_ANALYSIS_ENABLED=true
# OPENAI_IMAGE_BILLING_CONFIRMED=true
OPENAI_IMAGE_MODEL=gpt-6.1-sol
OPENAI_IMAGE_TIMEOUT_MS=45000
# Fallback temporário de fotos Gemini, também protegido por opt-in e confirmação de billing.
# GEMINI_IMAGE_ANALYSIS_ENABLED=true
# GEMINI_PAID_TIER_CONFIRMED=true
# GEMINI_IMAGE_MODEL=gemini-3.5-flash-lite
# GEMINI_IMAGE_TIMEOUT_MS=30000
# Projeto Supabase dedicado exclusivamente a fixtures sintéticas; nunca use dados reais.
# SUPABASE_INTEGRATION_DATABASE_URL=postgresql://<role>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full
# SUPABASE_INTEGRATION_CONFIRMATION=synthetic-only
# SUPABASE_INTEGRATION_CA_CERT=
# Baixe o certificado raiz PEM em Database Settings > SSL Configuration.
# O banco também deve ter o marcador aplicado por infrastructure/supabase/001-integration-guard.sql.
# Neon permanece como contingência até o projeto Supabase sintético ser validado.
# NEON_INTEGRATION_DATABASE_URL=postgresql://<role>:<password>@<host>.neon.tech/<database>?sslmode=require
# NEON_INTEGRATION_CONFIRMATION=synthetic-only
# Login Google (opcional no ambiente real; nunca versionar o client secret).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/v1/auth/google/callback
# GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=http://127.0.0.1:5173/
# Painel Zermatt: IDs internos de contas administrativas separados por vírgula.
# OBJECT_STORAGE_URL=

# Memória recente no mesmo chat; false desliga o envio de histórico ao modelo.
ALVITRA_CHAT_MEMORY_ENABLED=true
# Pesquisa pública experimental: somente DEMO_MODE local com Codex, nunca produção.
ALVITRA_DEMO_WEB_SEARCH_ENABLED=false

# Entrada por código fornecido (Spec 068). Nunca comitar valores reais.
# Em demonstração local, segredo e cofre ficam nesta pasta privada persistente.
ACCESS_CODE_DIRECTORY=.local/access-codes
# No modo real: segredo estável de 32 bytes em hexadecimal, backup obrigatório.
# ACCESS_CODE_SECRET=
# Somente na CLI de provisionamento: conexão do operador, nunca usada pelo servidor.
# ACCESS_CODE_OPERATOR_DATABASE_URL=

# Preparação operacional (Spec 070): o verificador não carrega este arquivo nem conecta serviços.
# Decisões sem segredos: infrastructure/pilot/operations-decisions.example.json.
# Ensaio integral exclusivo de PostgreSQL local descartável; nunca usar DATABASE_URL real aqui.
# PILOT_RECOVERY_CONFIRMATION=synthetic-local-only
# PILOT_RECOVERY_ADMIN_URL=postgresql://postgres:<synthetic-local-password>@127.0.0.1:5432/postgres
# O runner cria bancos alvitra_ops_source_<hex>/alvitra_ops_restore_<hex> e deixa ambos em quarentena.
# Backup de ACCESS_CODE_SECRET e AUTH_ACCOUNT_SECRET_KEY exige custódia separada do banco.
# Alternativa sem instalar CLIs no host: scripts/verify-pilot-recovery-container.ps1 -ConfirmSyntheticLocal.
# Exige Docker local disponível e pgvector/pgvector:pg17 em cache; não baixa imagem automaticamente.
# O wrapper usa SCRAM, senha pública de fixture por arquivo e encerra somente seu container.
# Se usar container próprio marcado, o CLI Node aceita PILOT_RECOVERY_DOCKER_CONTAINER=alvitra-ops-<hex>.
