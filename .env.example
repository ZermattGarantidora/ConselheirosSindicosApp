# Nunca registre valores reais neste arquivo.
APP_ENV=development
LOG_LEVEL=info
# Worker persistido: usa PostgreSQL com RLS e fila no banco.
# DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/conselheiro
# Staging remoto: use uma URL do provedor com TLS; nunca versionar a senha.
# DATABASE_URL=postgresql://<role>:<password>@<host>/<database>?sslmode=require
# DOCUMENT_STORAGE_ROOT=.local/synthetic-documents
# OCR da OpenAI: permitido exclusivamente para PDFs sintéticos, conforme ADR 0009.
# OPENAI_OCR_API_KEY=
# OPENAI_OCR_MODEL=gpt-5.6-luna
# OPENAI_OCR_TIMEOUT_MS=30000
# Respostas documentais Gemini: use apenas corpus sintético na faixa gratuita.
# A chave é lida apenas pelo servidor; nunca use prefixo VITE_ nem faça commit do valor.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT_MS=30000
# Banco Neon dedicado exclusivamente a fixtures sintéticas; nunca use dados reais.
# NEON_INTEGRATION_DATABASE_URL=postgresql://<role>:<password>@<host>.neon.tech/<database>?sslmode=require
# NEON_INTEGRATION_CONFIRMATION=synthetic-only
# O banco também deve ter o marcador aplicado por infrastructure/neon/001-integration-guard.sql.
# Login Google (opcional no ambiente real; nunca versionar o client secret).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/v1/auth/google/callback
# GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=http://127.0.0.1:5173/
# OBJECT_STORAGE_URL=
