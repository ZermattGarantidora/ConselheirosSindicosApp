# Nunca registre valores reais neste arquivo.
APP_ENV=development
# O site real é o padrão. Use true somente quando quiser abrir a demonstração sintética.
DEMO_MODE=false
# Mantém os documentos sintéticos fora da demonstração manual. Ative apenas para testes de consulta.
DEMO_SEED_DOCUMENTS=false
# Em testes locais, use false para não restaurar automaticamente a sessão no navegador.
AUTH_SESSION_AUTO_RESTORE=false
# Proteção de conta. A chave deve representar 32 bytes (hexadecimal ou base64url).
# Gere uma chave exclusiva por ambiente e nunca a versione.
# AUTH_ACCOUNT_SECRET_KEY=
# Sem provedor aprovado, apenas a prévia local pode ser usada fora de produção.
# A prévia não libera novas ativações de MFA.
# AUTH_EMAIL_DELIVERY=development
# AUTH_PUBLIC_BASE_URL=http://127.0.0.1:5173/
# No ambiente integrado de teste, processa uploads sem exigir outro terminal.
DOCUMENT_WORKER_IN_API=true
LOG_LEVEL=info
# Worker persistido: usa PostgreSQL com RLS e fila no banco.
# DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:5432/conselheiro
# Supabase persistente: use o projeto do ambiente com TLS; nunca versionar a senha.
# DATABASE_URL=postgresql://<role>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DOCUMENT_STORAGE_ROOT=.local/synthetic-documents
# OCR da OpenAI: somente harness sintético direto, nunca upload do servidor/worker.
# A chave do chat NÃO ativa OCR. Os três campos abaixo são obrigatórios no harness.
# OPENAI_OCR_ENABLED=true
# OPENAI_OCR_DATA_POLICY=synthetic-only
# OPENAI_OCR_API_KEY=
# OPENAI_OCR_MODEL=gpt-5.6-luna
# OPENAI_OCR_TIMEOUT_MS=30000
# Respostas com OpenAI: configure no servidor, nunca com prefixo VITE_.
# OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-6.1-sol
OPENAI_ANSWER_TIMEOUT_MS=45000
# OPENAI_ANSWER_ENABLED=true
# Gemini permanece disponível durante a migração e assume a conversa quando OpenAI não tem chave.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_RETRY_BASE_DELAY_MS=200
# GEMINI_ENABLED=true
# Fotos sintéticas: exige chave OpenAI, opt-in e confirmação operacional de billing.
# OPENAI_IMAGE_ANALYSIS_ENABLED=true
# OPENAI_IMAGE_BILLING_CONFIRMED=true
OPENAI_IMAGE_MODEL=gpt-6.1-sol
OPENAI_IMAGE_TIMEOUT_MS=45000
# Fallback temporário de fotos Gemini, também protegido por opt-in e confirmação de billing.
# GEMINI_IMAGE_ANALYSIS_ENABLED=true
# GEMINI_PAID_TIER_CONFIRMED=true
# GEMINI_IMAGE_MODEL=gemini-3.5-flash-lite
# GEMINI_IMAGE_TIMEOUT_MS=30000
# Projeto Supabase dedicado exclusivamente a fixtures sintéticas; nunca use dados reais.
# SUPABASE_INTEGRATION_DATABASE_URL=postgresql://<role>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SUPABASE_INTEGRATION_CONFIRMATION=synthetic-only
# O banco também deve ter o marcador aplicado por infrastructure/supabase/001-integration-guard.sql.
# Neon permanece como contingência até o projeto Supabase sintético ser validado.
# NEON_INTEGRATION_DATABASE_URL=postgresql://<role>:<password>@<host>.neon.tech/<database>?sslmode=require
# NEON_INTEGRATION_CONFIRMATION=synthetic-only
# Login Google (opcional no ambiente real; nunca versionar o client secret).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/v1/auth/google/callback
# GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=http://127.0.0.1:5173/
# Painel Zermatt: IDs internos de contas administrativas separados por vírgula.
# OBJECT_STORAGE_URL=
