+function normalized(value: string) {
+  return value
+    .trim()
+    .toLocaleLowerCase("pt-BR")
+    .normalize("NFD")
+    .replace(/[^a-z0-9?\s]/g, "")
+    .replace(/\s+/g, " ");
+}
+
+export function conversationalReply(message: string): string | undefined {
+  const value = normalized(message);
+
+  if (/^(oi|ola|bom dia|boa tarde|boa noite)( tudo bem)?$/.test(value)) {
+    return "Olá! Estou bem e pronto para ajudar. Pergunte sobre uma regra, decisão, contrato ou outro documento deste condomínio.";
+  }
+
+  if (/^(obrigado|obrigada|valeu|muito obrigado|muito obrigada)$/.test(value)) {
+    return "Por nada! Quando precisar, envie uma pergunta sobre os documentos deste condomínio.";
+  }
+
+  if (/^(como voce pode ajudar|o que voce faz|como funciona|me ajude|ajuda)$/.test(value)) {
+    return "Posso localizar regras, decisões e informações nos documentos autorizados desta conversa. Por exemplo: “Qual é a regra para locação por temporada?”";
+  }
+
+  return undefined;
+}
