+                  role="tab"
+                  aria-selected={step === id}
+                  type="button"
+                >
+                  {label}
+                </button>
+              ))}
+            </div>
+            <p className="preview-rule">
+              Um condomínio só entra na lista após autorização. Nenhum acesso é criado
+              automaticamente.
+            </p>
+          </aside>
+
+          <section className="phone" aria-label="Tela do celular">
+            <div className="phone-speaker" aria-hidden="true" />
+            <div className="phone-screen">
+              {step === "login" ? (
+                <LoginScreen onContinue={() => setStep("conversations")} />
+              ) : null}
+              {step === "conversations" ? (
+                <ConversationScreen onAdd={() => setStep("add")} />
+              ) : null}
+              {step === "add" ? <AddScreen onBack={() => setStep("conversations")} /> : null}
+            </div>
+          </section>
+        </div>
+      </section>
+    </main>
+  );
+}
+
