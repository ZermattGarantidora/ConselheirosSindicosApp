{
  "name": "conselheiro-virtual-sindicos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fundação local do MVP de consulta documental para síndicos.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs --eval \"import('./apps/api/app/server.ts').then(({ startServer }) => startServer())\"",
    "dev:web": "vite --config vite.config.ts",
    "review:synthetic": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "worker": "tsx -e \"import('./apps/api/worker/worker.ts').then(({ startPersistentWorkerFromEnvironment }) => startPersistentWorkerFromEnvironment())\"",
    "db:up": "docker compose up -d database",
    "db:migrate": "docker compose exec -T database sh -c \"for migration in /migrations/*.sql; do psql -U postgres -d conselheiro -v ON_ERROR_STOP=1 -f \\\"$migration\\\" || exit 1; done\"",
    "db:migrate:remote": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs scripts/migrate-database.ts",
    "db:migrate:neon": "node scripts/run-tsx.mjs scripts/migrate-neon-integration.ts",
    "format": "prettier --write \"*.{json,mjs,ts}\" \"{apps,tests,scripts,contracts,evals}/**/*.{ts,tsx,mjs,json}\"",
    "format:check": "prettier --check \"*.{json,mjs,ts}\" \"{apps,tests,scripts,contracts,evals}/**/*.{ts,tsx,mjs,json}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "evals:synthetic": "vitest run tests/e2e/synthetic-evals.e2e.test.ts",
    "pilot:synthetic": "vitest run tests/e2e/synthetic-pilot.e2e.test.ts",
    "test:coverage": "vitest run --coverage",
    "evals": "node scripts/run-tsx.mjs evals/run.ts",
    "test:specs": "pwsh -NoProfile -File scripts/validate-spec-vision.ps1",
    "test:secrets": "node scripts/scan-secrets.mjs",
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run test:specs && pnpm run test:secrets",
    "precommit": "pnpm run check",
    "verify:merge": "pwsh -NoProfile -File scripts/verify-merge.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "^5.12.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
