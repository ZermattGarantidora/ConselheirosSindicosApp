{
  "name": "conselheiro-virtual-sindicos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fundação local do MVP de consulta documental para síndicos.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "test:persistent-runtime": "vitest run --config tests/vitest.persistent-runtime.config.ts --coverage",
    "test:authoring:financial:browser": "node scripts/run-tsx.mjs scripts/verify-financial-report-browser.ts",
    "test:authoring:financial": "vitest run tests/unit/financial-review.test.ts tests/unit/financial-dossier.test.ts tests/unit/financial-report.test.ts tests/e2e/financial-report.e2e.test.ts",
    "evals:financial-300": "node scripts/run-tsx.mjs evals/financial-dossier/run.ts",
    "test:authoring": "vitest run --config tests/vitest.authoring.config.ts",
    "test:authoring:operations": "vitest run tests/unit/authoring-operations.test.ts",
    "test:authoring:postgres": "pwsh -NoProfile -File scripts/verify-pilot-recovery-container.ps1 -ConfirmSyntheticLocal -Suite authoring",
    "test:authoring:pdf": "node scripts/run-tsx.mjs scripts/verify-authoring-pdf.ts",
    "test:authoring:audio:pdf": "node scripts/run-tsx.mjs scripts/verify-audio-minutes-pdf.ts",
    "test:authoring:browser": "node scripts/run-tsx.mjs scripts/verify-audio-minutes-browser.ts",
    "evals:audio-minutes": "node scripts/run-tsx.mjs evals/audio-minutes/run.ts",
    "evals:document-authoring": "node scripts/run-tsx.mjs evals/document-authoring/run.ts",
    "evals:authoring:homologation": "node scripts/run-tsx.mjs evals/authoring-homologation/run.ts",
    "evals:authoring:homologation:audio": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/generate-authoring-homologation-audio.ps1",
    "evals:authoring:local": "node scripts/run-tsx.mjs evals/authoring-homologation/run-local.ts",
    "test:authoring:general:browser": "node scripts/run-tsx.mjs scripts/verify-document-authoring-browser.ts",
    "test:authoring:originals": "vitest run tests/unit/original-document-improvements.test.ts tests/e2e/original-document-improvements.e2e.test.ts",
    "test:authoring:originals:browser": "node scripts/run-tsx.mjs scripts/verify-original-authoring-browser.ts",
    "dev:api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.admin.local scripts/run-tsx.mjs --eval \"import('./apps/api/app/server.ts').then(({ startServer }) => startServer())\"",
    "start": "node dist/api/app/main.js",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "build:api": "tsc --project tsconfig.api.json",
    "worker": "tsx -e \"import('./apps/api/worker/worker.ts').then(({ startPersistentWorkerFromEnvironment }) => startPersistentWorkerFromEnvironment())\"",
    "worker:continuous": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs apps/api/worker/main.ts",
    "worker:start": "node dist/api/worker/main.js",
    "test:worker:separate": "pnpm run build:api && node --env-file-if-exists=.env.local --env-file-if-exists=.env.admin.local scripts/run-tsx.mjs scripts/verify-separated-worker.mjs",
    "db:up": "docker compose up -d database",
    "db:migrate": "docker compose exec -T database sh -c \"for migration in /migrations/*.sql; do psql -U postgres -d conselheiro -v ON_ERROR_STOP=1 -f \\\"$migration\\\" || exit 1; done\"",
    "db:migrate:remote": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs scripts/migrate-database.ts",
    "documents:migrate-local-to-postgres": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs scripts/migrate-local-document-originals.ts",
    "legal:import:constitution": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs scripts/import-brazilian-constitution.ts",
    "legal:build": "node scripts/run-tsx.mjs scripts/build-verified-legal-corpus.ts",
    "legal:import:verified": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs scripts/import-verified-legal-corpus.ts",
    "db:migrate:neon": "node scripts/run-tsx.mjs scripts/migrate-neon-integration.ts",
    "db:migrate:supabase": "node scripts/run-tsx.mjs scripts/migrate-supabase-integration.ts",
    "format": "prettier --write \"*.{json,mjs,ts}\" \"{apps,tests,scripts,contracts,evals}/**/*.{ts,tsx,mjs,json}\"",
    "format:check": "prettier --check \"*.{json,mjs,ts}\" \"{apps,tests,scripts,contracts,evals}/**/*.{ts,tsx,mjs,json}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:pilot:security": "vitest run --config tests/vitest.pilot-security.config.ts",
    "test:pilot:budget": "vitest run --config tests/vitest.operation-budget.config.ts --coverage",
    "test:pilot:integration:local": "vitest run --config tests/vitest.pilot-integration.config.ts",
    "test:pilot:security:postgres": "vitest run --config tests/vitest.pilot-security-postgres.config.ts",
    "test:pilot:data:local": "vitest run --config tests/vitest.pilot-data-controls.config.ts",
    "test:pilot:documents": "vitest run --config tests/vitest.pilot-documents.config.ts",
    "pilot:preparation": "node scripts/run-tsx.mjs scripts/verify-pilot-preparation.ts",
    "test:pilot:operations": "vitest run --config infrastructure/pilot/vitest.operations.config.ts --coverage",
    "test:render": "vitest run --config tests/vitest.render.config.ts --coverage",
    "test:pilot:recovery:local": "node scripts/run-tsx.mjs scripts/verify-pilot-recovery.ts",
    "test:pilot:recovery:container": "pwsh -NoProfile -File scripts/verify-pilot-recovery-container.ps1 -ConfirmSyntheticLocal",
    "test:pilot:worker:local": "pwsh -NoProfile -File scripts/verify-pilot-recovery-container.ps1 -ConfirmSyntheticLocal -Suite worker",
    "test:pilot:rls:local": "pwsh -NoProfile -File scripts/verify-pilot-recovery-container.ps1 -ConfirmSyntheticLocal -Suite rls",
    "pilot:observation": "node scripts/run-tsx.mjs scripts/verify-pilot-observation.ts",
    "test:demo-web": "vitest run tests/unit/demo-web-research.test.ts tests/unit/public-service-research.test.ts tests/unit/question-response.test.ts tests/e2e/demo-web-research.e2e.test.ts",
    "test:documents:full-pages": "vitest run tests/e2e/full-page-document-ingestion.e2e.test.ts",
    "test:documents:long": "vitest run tests/e2e/long-pdf-ingestion.e2e.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:production": "node scripts/verify-production-runtime.mjs",
    "evals:synthetic": "vitest run tests/e2e/synthetic-evals.e2e.test.ts",
    "evals:legal": "vitest run tests/e2e/verified-legal-evals.e2e.test.ts",
    "pilot:synthetic": "vitest run tests/e2e/synthetic-pilot.e2e.test.ts",
    "test:coverage": "vitest run tests/unit --coverage",
    "evals": "node scripts/run-tsx.mjs evals/run.ts",
    "evals:full-pages": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/full-page-documents/run.ts",
    "evals:pdf-300": "pnpm run build:api && node scripts/run-tsx.mjs evals/long-pdf/run.ts",
    "evals:demo-documents": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/demo-documents/run.ts",
    "evals:demo-long": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/demo-documents/run-long.ts",
    "evals:documentary": "node scripts/run-tsx.mjs evals/documentary-quality/run.ts",
    "evals:documentary:semantic": "node scripts/run-tsx.mjs evals/documentary-quality/semantic/run.ts",
    "evals:conversations": "node scripts/run-tsx.mjs evals/conversations/run.ts",
    "evals:comparison": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/run.ts",
    "evals:cost-30": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/run.ts --suite=cost30",
    "evals:dense-documents": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/dense-documents/run.ts",
    "evals:dense-comparison": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/dense-documents/compare.ts",
    "evals:dense-stress": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/dense-documents/stress-run.ts",
    "evals:hybrid": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/run.ts --suite=hybrid",
    "evals:luna": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/run.ts --suite=luna",
    "evals:sol": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/run.ts --suite=sol",
    "evals:corrected": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/run.ts --suite=corrected",
    "evals:recovery": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/recovery.ts",
    "evals:answer-quality": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/conversation-comparison/recovery.ts --stage=blockers",
    "evals:zermatt": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs evals/zermatt/run.ts",
    "test:specs": "pwsh -NoProfile -File scripts/validate-spec-vision.ps1",
    "test:secrets": "node scripts/scan-secrets.mjs",
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run test:specs && pnpm run test:secrets",
    "precommit": "pnpm run check",
    "verify:merge": "pwsh -NoProfile -File scripts/verify-merge.ps1",
    "access:issue": "node --env-file-if-exists=.env.local scripts/run-tsx.mjs scripts/issue-access-code.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "^5.12.5",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
